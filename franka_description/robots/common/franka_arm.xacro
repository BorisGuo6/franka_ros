      </collision>
    </link>

    <joint name="table_joint" type="fixed">
      <origin xyz="0.6 0  0.214" rpy="0 0 0"/>
      <parent link="panda_link0"/>
      <child link="table"/>
    </joint>

      <visual>
        <geometry>
