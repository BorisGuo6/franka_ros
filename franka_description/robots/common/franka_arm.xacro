    <!-- <enable_collisions link1="table" link2="left_finger_tip" reason="Adjacent" />
    <enable_collisions link1="table" link2="right_finger_tip" reason="Adjacent" />
    <enable_collisions link1="back_wall" link2="left_finger_tip" reason="Adjacent" />
    <enable_collisions link1="back_wall" link2="right_finger_tip" reason="Adjacent" />
    <enable_collisions link1="camera_link" link2="table" reason="Adjacent" />
    <enable_collisions link1="camera_link" link2="back_wall" reason="Adjacent" /> -->
</robot>
